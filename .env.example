# ==============================================================================
# WAPPAY BANKING PLATFORM ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application & Runtime
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# CRITICAL SECURITY GATE: Simulated Mode
# In development & staging, MUST be true.
# In production, setting this to false requires multi-party verification and license verification.
IS_SIMULATED=true

# Database Connection (PostgreSQL / Supabase)
# DATABASE_MODE=mock     -> in-memory mock DB (unit tests, offline dev)
# DATABASE_MODE=postgres -> real PostgreSQL (Supabase project)
# Supabase credentials live in .env (gitignored). Never commit real credentials.
# DATABASE_URL        = direct endpoint (port 5432) — app + migrations
# DATABASE_URL_UNPOOLED = same direct endpoint (kept for Prisma migrate compatibility)
DATABASE_MODE=postgres
DATABASE_URL="postgresql://USER:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require"
SUPABASE_PROJECT_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Redis Cache, Locks, and Job Queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets for Admin Authentication
JWT_ACCESS_SECRET="change-this-to-a-secure-256-bit-key-in-production-access"
JWT_REFRESH_SECRET="change-this-to-a-secure-256-bit-key-in-production-refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Meta WhatsApp Cloud API Credentials
WHATSAPP_ACCESS_TOKEN="mock_access_token"
WHATSAPP_PHONE_NUMBER_ID="mock_phone_number_id"
WHATSAPP_BUSINESS_ACCOUNT_ID="mock_business_account_id"
WHATSAPP_VERIFY_TOKEN="mock_verify_token"
WHATSAPP_APP_SECRET="mock_app_secret"
WHATSAPP_API_URL="https://graph.facebook.com/v21.0"
WHATSAPP_API_TIMEOUT_MS=10000

# WhatsApp Flows (in-chat forms: TextInput / Dropdown / OptIn)
# Upload src/modules/whatsapp-flows/flows/wappay-signup.json in Meta Flows
# (Business Manager → WhatsApp → Flows → Create), then paste the Flow ID.
# Use mode=draft while testing; publish when ready.
WHATSAPP_REGISTRATION_FLOW_ID=""
WHATSAPP_DEPOSIT_FLOW_ID=""
WHATSAPP_FLOW_MODE=draft
WHATSAPP_FLOW_ENCRYPTION=false
# WHATSAPP_FLOW_PRIVATE_KEY=
# WHATSAPP_FLOW_PUBLIC_KEY=
# Callback URL for data_exchange flows (must be public HTTPS):
# WHATSAPP_FLOW_CALLBACK_URL=https://your-domain.example/api/v1/flows/data

# Financial Environment Mode: "mock" (simulation) or "live" (production)
# When FINANCIAL_MODE=mock, all transactions are strictly simulated and isolated.
FINANCIAL_MODE=mock

# Financial Provider Settings (Default: sandbox)
FINANCIAL_PROVIDER=sandbox
FINANCIAL_PROVIDER_PUBLIC_KEY="pk_test_sample"
FINANCIAL_PROVIDER_SECRET_KEY="sk_test_sample"
FINANCIAL_PROVIDER_WEBHOOK_SECRET="whsec_sample"

# Conversational AI & Voice Services (Groq AI)
# When configured, inbound messages use Groq structured intent extraction; otherwise the deterministic sandbox parser is used.
AI_PROVIDER=groq
GROQ_API_KEY="gsk_sample_api_key"
GROQ_MODEL="openai/gpt-oss-120b"
OPENAI_API_KEY="sk-sample"

# Financial Invariant Settings
CURRENCY=NGN
CURRENCY_PRECISION=100
MAX_DAILY_TRANSFER_LIMIT_KOBO=50000000 # 500,000 NGN in Kobo
DEFAULT_TRANSFER_FEE_KOBO=1000 # 10 NGN in Kobo
